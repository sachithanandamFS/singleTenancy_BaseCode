PORT=4000
NODE_ENV=development

# local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Subash005!
POSTGRES_DB=servu_platform

DEV_ORIGIN=http://localhost:3000
PROD_ORIGIN=https://spearfox.com

#Cloud Storage info
gc_csi_s3_bucket=
gc_csi_s3_key=
gc_csi_s3_SECRET=
gc_csi_s3_REGION=
gc_csi_s3_URL=

# JWT Configuration
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Redis Host
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_TLS=false

# ============ HOSTING.COM SPECIFIC ============
# For hosting.com LiteSpeed Redis Cache:
# - Access via cpanel > LiteSpeed Cache > Redis Cache Manager
# - Default host: 127.0.0.1
# - Default port: 6379
# - TLS is not needed (local connection)

#REDIS_PROVIDER=hosting.com
#REDIS_SOCKET_PATH=/home/hyrcabsc/.redis/redis.sock
#REDIS_PASSWORD=
#REDIS_DB=0

# ============ AWS ELASTICACHE SPECIFIC ============
# For AWS ElastiCache:
# - REDIS_PROVIDER=aws
# - REDIS_HOST=<your-elasticache-endpoint>
# - REDIS_PORT=6379 (or custom)
# - REDIS_PASSWORD=<your-auth-token> (if AUTH enabled)
# - REDIS_TLS=true (for encryption in transit)
# - REDIS_USERNAME=default (for IAM auth with ElastiCache)

# ============ OTP SETTINGS ============
#OTP_EXPIRY_MINUTES=10
#OTP_MAX_ATTEMPTS=5
#OTP_LENGTH=5

check_add_sec='FALSE'

# ============ AUTH PROVIDER ============
# Default: local JWT (use_auth0 absent or FALSE)
# Set use_auth0=TRUE to switch all authentication to Auth0.
# When enabled, JWT_ACCESS_SECRET is no longer used for verification.
use_auth0=FALSE

# Required when use_auth0=TRUE:
#AUTH0_DOMAIN=myapp.auth0.com
#AUTH0_AUDIENCE=https://api.myapp.com
#AUTH0_NAMESPACE=https://myapp.com/
#
# Auth0 Action (Post-Login) — attach these to every access token:
#
#   exports.onExecutePostLogin = async (event, api) => {
#     const ns = 'https://myapp.com/';
#     api.accessToken.setCustomClaim(`${ns}user_id`,    event.user.app_metadata.db_user_id);
#     api.accessToken.setCustomClaim(`${ns}user_type`,  event.user.app_metadata.user_type);
#     api.accessToken.setCustomClaim(`${ns}permissions`, event.user.app_metadata.permissions ?? []);
#   };
#
# Each Auth0 user must have app_metadata set:
#   db_user_id  → your Postgres users.id (number)
#   user_type   → 1 (SUPERADMIN) | 2 (ADMIN) | 3 (EMPLOYEE)
#   permissions → array matching JwtUserPayload.permissions structure

# ============ SSO PROVIDER (Generic OIDC) ============
# Set use_sso=TRUE to authenticate via any OIDC-compliant identity provider.
# use_auth0 takes priority — only one provider should be TRUE at a time.
use_sso=FALSE

# Required when use_sso=TRUE:
#SSO_JWKS_URI=
#SSO_ISSUER=
#SSO_AUDIENCE=
#SSO_NAMESPACE=https://myapp.com/
#
# Provider examples:
#   Okta:      SSO_JWKS_URI=https://mycompany.okta.com/oauth2/default/v1/keys
#              SSO_ISSUER=https://mycompany.okta.com/oauth2/default
#
#   Azure AD:  SSO_JWKS_URI=https://login.microsoftonline.com/{tenant-id}/discovery/v2.0/keys
#              SSO_ISSUER=https://login.microsoftonline.com/{tenant-id}/v2.0
#
#   Google:    SSO_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
#              SSO_ISSUER=https://accounts.google.com
#
#   Keycloak:  SSO_JWKS_URI=https://keycloak.mycompany.com/realms/{realm}/protocol/openid-connect/certs
#              SSO_ISSUER=https://keycloak.mycompany.com/realms/{realm}
#
# Custom claims (same namespace pattern as Auth0 — configure in your IdP's claim mapping):
#   <SSO_NAMESPACE>user_id    → number  (your Postgres users.id)
#   <SSO_NAMESPACE>user_type  → number  (1=SUPERADMIN, 2=ADMIN, 3=EMPLOYEE)
#   <SSO_NAMESPACE>permissions → array  (same shape as JwtUserPayload.permissions)
