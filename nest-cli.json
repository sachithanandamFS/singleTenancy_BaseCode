{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "../locales/**/*", "outDir": "./dist/locales", "watchAssets": false },
      { "include": "../resources/**/*", "outDir": "./dist/resources", "watchAssets": false }
    ]
  }
}
